[Unit]
Description=Fundus Review sync (Spark <-> Firebase review app, outgoing only)
After=network-online.target fundus-mcp.service

[Service]
Type=simple
WorkingDirectory=%h/Projects/Software/Fundus
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/Projects/Software/Fundus/.venv/bin/python -m fundus.cli review sync --loop --interval 30
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
